      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (metric) (rate(mesh_judge_score_sum[1h])) / clamp_min(sum by (metric) (rate(mesh_judge_score_count[1h])), 1e-9)",
          "legendFormat": "{{metric}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 10,
