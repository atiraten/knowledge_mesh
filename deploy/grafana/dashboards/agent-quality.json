    {
      "id": 9,
      "type": "timeseries",
      "title": "LLM-judge scores (hourly average)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
